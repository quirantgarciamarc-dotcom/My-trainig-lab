# Frontend/public build-time values. These values are public, so protect the database with Supabase RLS.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_O_ANON_KEY
EXPO_PUBLIC_COACH_API_URL=https://TU-SITIO.netlify.app/.netlify/functions/coach-ai

# Netlify Function runtime variables. Configure these in Netlify, not in frontend source.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_O_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY_SOLO_SERVIDOR
ANTHROPIC_API_KEY=TU_CLAVE_PRIVADA_ANTHROPIC
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional fallback token for a single-user/local setup; authenticated Supabase users use their JWT.
COACH_ACCESS_TOKEN=TOKEN_ALEATORIO_LARGO_DE_AL_MENOS_24_CARACTERES
# Optional explicit allowed origins, comma-separated.
# COACH_ALLOWED_ORIGINS=https://tu-sitio.netlify.app,https://tu-dominio.com
